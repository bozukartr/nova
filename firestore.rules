rules_version = '2';

/* NOVA · Kritik Kütle — oda güvenlik kuralları
 *
 * Dağıtım:  firebase deploy --only firestore:rules
 *
 * Bu dosya dağıtılmadan proje varsayılan/test kurallarında kalır ve odalar
 * herkese açık olur. Kurallar dağıtıldığında:
 *   · odalar tek tek okunabilir ama listelenemez (kod taraması yapılamaz),
 *   · odayı yalnız kurucu ile katılan değiştirebilir,
 *   · kurucu ve tahta ayarları oda kurulduktan sonra değiştirilemez,
 *   · odayı yalnız kurucu silebilir.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    match /rooms/{code} {
      function isPlayer() {
        return request.auth != null && (
          request.auth.uid == resource.data.host ||
          request.auth.uid == resource.data.guest
        );
      }

      // Katılan oyuncu boş yuvaya yalnız kendi kimliğini yazabilir.
      function isJoining() {
        return request.auth != null
          && resource.data.guest == null
          && request.resource.data.guest == request.auth.uid;
      }

      // Oda kimliğine ve kurucusuna sonradan dokunulamaz.
      function keepsIdentity() {
        return request.resource.data.host == resource.data.host
          && request.resource.data.code == resource.data.code
          && request.resource.data.board == resource.data.board
          && request.resource.data.series == resource.data.series;
      }

      function sane() {
        return request.resource.data.moves is list
          && request.resource.data.moves.size() < 500
          && request.resource.data.round is int
          && request.resource.data.round > 0;
      }

      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
        && code.matches('^[0-9]{4}$')
        && request.resource.data.code == code
        && request.resource.data.host == request.auth.uid
        && request.resource.data.guest == null
        && request.resource.data.status == 'waiting'
        && request.resource.data.round == 1
        && request.resource.data.moves.size() == 0;

      allow update: if (isPlayer() || isJoining()) && keepsIdentity() && sane();

      allow delete: if request.auth != null && request.auth.uid == resource.data.host;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
